{
  "name": "cambuz-pdf",
  "productName": "Cambuz PDF Reader",
  "version": "1.1.0",
  "description": "Cambuz PDF Reader \u2014 A lightweight, fast PDF reader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "build": "npm run build:win",
    "build:win": "node scripts/stage-app.mjs && electron-builder --win --x64 --publish never",
    "build:linux": "node scripts/stage-app.mjs && electron-builder --linux --x64 --publish never",
    "build:mac": "node scripts/stage-app.mjs && electron-builder --mac --arm64 --publish never",
    "build:dir": "node scripts/stage-app.mjs && electron-builder --win --x64 --dir --publish never",
    "samples": "node scripts/create-samples.js && python3 scripts/create-unicode-samples.py",
    "samples:js": "node scripts/create-samples.js",
    "samples:unicode": "python3 scripts/create-unicode-samples.py",
    "samples:secure": "node scripts/create-secure-samples.js && python3 scripts/create-secure-samples.py",
    "samples:phase6": "python3 scripts/create-phase6-samples.py",
    "samples:phase7": "node scripts/create-phase7-samples.mjs",
    "test": "node scripts/test-phase2.mjs && node scripts/test-phase2-dom.mjs && node scripts/test-phase3.mjs && node scripts/test-phase4.mjs && node scripts/test-phase5.mjs && node scripts/test-phase6.mjs && node scripts/test-phase7.mjs && node scripts/test-samples.mjs && node scripts/test-context-menu.mjs && node scripts/test-text-selection.mjs && node scripts/test-main-process.mjs && node scripts/test-phase8.mjs && node scripts/test-phase11.mjs",
    "test:node": "node scripts/test-phase2.mjs",
    "test:dom": "node scripts/test-phase2-dom.mjs",
    "test:phase3": "node scripts/test-phase3.mjs",
    "test:phase4": "node scripts/test-phase4.mjs",
    "test:phase5": "node scripts/test-phase5.mjs",
    "test:phase6": "node scripts/test-phase6.mjs",
    "test:phase7": "node scripts/test-phase7.mjs",
    "test:packaged": "node scripts/smoke-test-packaged.mjs",
    "test:phase8": "node scripts/test-phase8.mjs",
    "benchmark:phase8": "node --expose-gc scripts/benchmark-phase8.mjs",
    "test:phase11": "node scripts/test-phase11.mjs"
  },
  "author": "Cambuz",
  "license": "MIT",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-nastaliq-urdu": "^0.4.2",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@expo-google-fonts/noto-sans-gujarati": "^0.4.2",
    "@expo-google-fonts/noto-sans-gurmukhi": "^0.4.1",
    "@expo-google-fonts/noto-sans-kannada": "^0.4.3",
    "@expo-google-fonts/noto-sans-malayalam": "^0.4.2",
    "@expo-google-fonts/noto-sans-oriya": "^0.4.2",
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@expo-google-fonts/noto-sans-telugu": "^0.4.2",
    "@napi-rs/canvas": "^1.0.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "express": "^4.22.3",
    "jsdom": "^30.1.2"
  },
  "build": {
    "appId": "com.cambuz.pdfreader",
    "productName": "Cambuz PDF Reader",
    "copyright": "Copyright \u00a9 2026 Cambuz",
    "directories": {
      "app": ".build-app",
      "output": "dist"
    },
    "npmRebuild": false,
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "CambuzPDFReader.Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "differentialPackage": false,
      "artifactName": "Cambuz-PDF-Reader-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Cambuz-PDF-Reader-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "cambuz-pdf-reader",
      "category": "Office",
      "artifactName": "Cambuz-PDF-Reader-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Cambuz-PDF-Reader-${version}-mac-${arch}.${ext}"
    }
  }
}
